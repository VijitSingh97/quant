# Copy to .env and edit. All optional — sensible defaults apply if omitted.
# (Legacy BTCVOL_* names still work too.)

# --- mode / scheduler ---
BASIS_MODE=paper                 # paper (default) | live  (live order signing is gated off)
BASIS_CYCLE_SECONDS=3600         # how often the scheduler runs a cycle
BASIS_TASKS=logger,paper,auto    # which cycles to run each tick

# --- capital / strategy ---
BASIS_CAPITAL_BTC=0.1            # paper seed / target capital
BASIS_DEPLOY_FRACTION=0.85       # fraction deployed; rest is buffer
# BASIS_SYMBOL=BTC               # fixed-asset paper carry book (the `paper` task)

# --- auto-rotation (the `auto` task) ---
# BASIS_AUTO_SPOT_UNIVERSE=BTC,ETH,SOL,HYPE   # spot-able rotation set (=ANY to allow all)
# BASIS_AUTO_SWITCH_MARGIN=0.05               # hysteresis: APR edge required to rotate
# BASIS_AUTO_MIN_FUNDING=0.05                 # min trailing APR to deploy at all

# --- risk limits (USD; hard ceilings enforced pre-trade) ---
# BASIS_MAX_NOTIONAL_USD=10000
# BASIS_MAX_LEVERAGE=2.0
# BASIS_MAX_ORDER_USD=3000
# BASIS_MAX_ABS_DELTA_USD=1200

# --- web dashboard ---
BASIS_WEB_PORT=8787
# BASIS_WEB_DB=live_auto.db      # which book the dashboard shows (live.db | live_auto.db)

# --- read-only live account (Phase 1; public address, NO secret) ---
# BASIS_HL_ADDRESS=0xYourHyperliquidAddress

# --- live trading (Phase 3; only if BASIS_MODE=live). Trade-enabled, withdraw-DISABLED. ---
# BASIS_HL_API_SECRET=
